<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>G&M CHOCOLATE COMERCIALIZADORA S.A DE C.V</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --p: #2d1b10; --s: #c5a059; --acc: #1b5e20; --bg: #fdfaf6; }
        body { font-family: 'Poppins', sans-serif; margin: 0; background: var(--bg); color: #333; scroll-behavior: smooth; }

        /* Navegación */
        nav { background: var(--p); color: white; padding: 15px 5%; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; border-bottom: 3px solid var(--s); }
        .logo { line-height: 1; }
        .logo span { display: block; font-size: 0.7rem; color: var(--s); letter-spacing: 2px; }
        .nav-links a { color: white; text-decoration: none; margin-left: 20px; font-size: 0.85rem; font-weight: 600; }
        .nav-links a:hover { color: var(--s); }

        /* Portada */
        .hero { 
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1548907040-4baa42d10919?auto=format&fit=crop&w=1350&q=80');
            height: 60vh; background-size: cover; background-position: center; display: flex; flex-direction: column; justify-content: center; align-items: center; color: white; text-align: center;
        }
        .hero h1 { font-family: 'Playfair Display', serif; font-size: 3.5rem; margin: 0; }
        .hero p { color: var(--s); font-size: 1.2rem; letter-spacing: 2px; }

        /* Misión, Visión, Objetivo */
        .mvo-container { padding: 80px 5%; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; background: white; }
        .mvo-card { padding: 30px; border: 1px solid #eee; border-radius: 15px; text-align: center; transition: 0.3s; }
        .mvo-card:hover { border-color: var(--s); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
        .mvo-card h2 { font-family: 'Playfair Display', serif; color: var(--p); }

        /* Catálogo con Filtros */
        .catalogo-section { padding: 80px 5%; }
        .tabs { display: flex; justify-content: center; gap: 20px; margin-bottom: 40px; }
        .tab-btn { padding: 10px 25px; border: 2px solid var(--p); background: transparent; cursor: pointer; font-weight: bold; border-radius: 30px; }
        .tab-btn.active { background: var(--p); color: white; }

        .grid-p { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px; }
        .card-p { background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        .card-p img { width: 100%; height: 250px; object-fit: cover; }
        .info-p { padding: 20px; text-align: center; }
        
        /* Botones */
        .btn-add { background: var(--p); color: white; border: none; padding: 12px; width: 100%; border-radius: 8px; cursor: pointer; font-weight: bold; }
        .cart-float { position: fixed; bottom: 30px; right: 30px; background: var(--acc); color: white; padding: 15px 25px; border-radius: 50px; cursor: pointer; font-weight: bold; z-index: 1000; }

        footer { background: var(--p); color: white; text-align: center; padding: 50px; }
    </style>
</head>
<body>

<nav>
    <div class="logo">G&M CHOCOLATE<span>COMERCIALIZADORA S.A DE C.V</span></div>
    <div class="nav-links">
        <a href="#inicio">Inicio</a>
        <a href="#nosotros">Nosotros</a>
        <a href="#catalogo">Catálogo</a>
    </div>
</nav>

<section class="hero" id="inicio">
    <h1>G&M CHOCOLATE</h1>
    <p>Excelencia sensorial en cada bocado</p>
</section>

<section class="mvo-container" id="nosotros">
    <div class="mvo-card">
        <h2>Nuestra Misión</h2>
        <p>Deleitar los paladares más exigentes mediante la comercialización de chocolates de alta calidad, promoviendo la riqueza del cacao y apoyando prácticas de comercio justo.</p>
    </div>
    <div class="mvo-card">
        <h2>Nuestra Visión</h2>
        <p>Convertirnos para el año 2030 en la comercializadora referente de chocolatería fina en la región, reconocida por nuestra innovación y momentos inolvidables.</p>
    </div>
    <div class="mvo-card">
        <h2>Nuestro Objetivo</h2>
        <p>Posicionarnos como la comercializadora líder de chocolates de especialidad, ofreciendo una experiencia sensorial única que eduque y deleite al consumidor.</p>
    </div>
</section>

<section class="catalogo-section" id="catalogo">
    <h2 style="text-align: center; font-family: 'Playfair Display'; font-size: 2.5rem;">Nuestra Selección</h2>
    
    <div class="tabs">
        <button class="tab-btn active" onclick="filtrar('todos', this)">Todos</button>
        <button class="tab-btn" onclick="filtrar('pieza', this)">Por Pieza</button>
        <button class="tab-btn" onclick="filtrar('paquete', this)">Por Paquete</button>
    </div>

    <div class="grid-p" id="lista-p">
        </div>
</section>

<div class="cart-float" onclick="checkout()">🛒 Mi Pedido (<span id="count">0</span>)</div>

<footer>
    <p><strong>G&M CHOCOLATE COMERCIALIZADORA S.A DE C.V</strong></p>
    <p>Ciudad de México, Tláhuac | 2026</p>
</footer>

<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/9.15.0/firebase-app.js";
    import { getDatabase, ref, onValue } from "https://www.gstatic.com/firebasejs/9.15.0/firebase-database.js";

    const firebaseConfig = {
        apiKey: "AIzaSyCzatiz291NiVyas9N-oCtao90nZftoEjA",
        authDomain: "chocolateserp-88328.firebaseapp.com",
        databaseURL: "https://chocolateserp-88328-default-rtdb.firebaseio.com",
        projectId: "chocolateserp-88328",
        storageBucket: "chocolateserp-88328.firebasestorage.app",
        messagingSenderId: "969925522046",
        appId: "1:969925522046:web:25653515d6ab05e0e51e2f"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);
    let items = [];
    let cart = [];

    onValue(ref(db, 'productos'), (s) => {
        const d = s.val();
        items = d ? Object.keys(d).map(k => ({id:k, ...d[k]})) : [];
        render(items);
    });

    function render(data) {
        const contenedor = document.getElementById('lista-p');
        contenedor.innerHTML = data.map(p => `
            <div class="card-p">
                <img src="${p.imagen || 'https://images.unsplash.com/photo-1511381939415-e44015466834?auto=format&fit=crop&w=500&q=80'}">
                <div class="info-p">
                    <h3>${p.nombre}</h3>
                    <div style="font-size: 1.4rem; color: var(--acc); font-weight: bold; margin-bottom: 15px;">$${p.precio}</div>
                    <button class="btn-add" onclick="add('${p.id}')">Agregar</button>
                </div>
            </div>
        `).join('');
    }

    window.filtrar = (tipo, btn) => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        if(tipo === 'todos') return render(items);
        
        // Filtramos: si el nombre del producto contiene "Paquete", va a paquetes, si no, a piezas
        const filtrados = items.filter(p => {
            const nombre = p.nombre.toLowerCase();
            return tipo === 'paquete' ? nombre.includes('paquete') : !nombre.includes('paquete');
        });
        render(filtrados);
    };

    window.add = (id) => {
        const p = items.find(i => i.id === id);
        cart.push(p);
        document.getElementById('count').innerText = cart.length;
    };

    window.checkout = () => {
        if(cart.length === 0) return alert("Tu carrito está vacío.");
        const total = cart.reduce((s, i) => s + parseFloat(i.precio), 0);
        alert("G&M CHOCOLATE S.A DE C.V\nFolio: " + Math.floor(Math.random()*9999) + "\nTotal: $" + total.toFixed(2));
    };
</script>
</body>
</html>
